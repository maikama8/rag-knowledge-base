# Copy to .env and fill in the values you need.
# The app runs offline with the defaults below.

# offline | openai
EMBEDDING_PROVIDER=offline

# offline | openai
LLM_PROVIDER=offline

# local numpy cosine store. The VectorStore interface is the extension point.
VECTOR_STORE=local

# Index files (index.json and vectors.npy). One process should own this directory.
DATA_DIR=./data

# Chunking. CHUNK_OVERLAP must be smaller than CHUNK_SIZE.
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval.
TOP_K=4
MIN_SCORE=0.15

# Width of the offline hashing embedder.
OFFLINE_EMBEDDING_DIMENSIONS=512

# Required only when a provider above is set to openai.
OPENAI_API_KEY=

# Optional OpenAI-compatible API root.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Maximum upload size in bytes (default 25 MiB).
MAX_UPLOAD_BYTES=26214400
